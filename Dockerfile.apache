
# ==========================================================
# STAGE 1: BUILD FRONTEND ASSETS (VITE + TAILWIND)
# ==========================================================
FROM node:22-alpine AS assets

WORKDIR /app

COPY package*.json ./

RUN npm install --no-audit --no-fund

COPY . .

RUN npm run build


# ==========================================================
# STAGE 2: PHP 8.3 + APACHE RUNTIME
# ==========================================================
FROM php:8.3-apache

WORKDIR /var/www/html

# ----------------------------------------------------------
# INSTALL SYSTEM DEPENDENCIES AND PHP EXTENSIONS
# ----------------------------------------------------------
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        git \
        unzip \
        libzip-dev \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev; \
    docker-php-ext-configure gd --with-freetype --with-jpeg; \
    docker-php-ext-install -j"$(nproc)" \
        pdo_mysql \
        bcmath \
        zip \
        gd \
        opcache; \
    rm -rf /var/lib/apt/lists/*


# ----------------------------------------------------------
# FIX APACHE MPM CONFLICT
# ENABLE ONLY MPM_PREFORK
# ----------------------------------------------------------
RUN set -eux; \
    a2dismod mpm_event mpm_worker mpm_prefork || true; \
    rm -f /etc/apache2/mods-enabled/mpm_*.load \
          /etc/apache2/mods-enabled/mpm_*.conf; \
    a2enmod mpm_prefork rewrite headers; \
    echo "ServerName localhost" > /etc/apache2/conf-available/servername.conf; \
    a2enconf servername; \
    test "$(apache2ctl -M 2>/dev/null | grep -Ec 'mpm_(event|worker|prefork)_module')" -eq 1; \
    apache2ctl configtest


# ----------------------------------------------------------
# CONFIGURE APACHE DOCUMENT ROOT FOR LARAVEL
# ----------------------------------------------------------
ENV APACHE_DOCUMENT_ROOT=/var/www/html/public

RUN sed -ri \
    -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' \
    /etc/apache2/sites-available/*.conf \
    && sed -ri \
    -e 's!/var/www/!${APACHE_DOCUMENT_ROOT}!g' \
    /etc/apache2/apache2.conf \
    /etc/apache2/conf-available/*.conf \
    && sed -ri \
    -e 's/AllowOverride None/AllowOverride All/' \
    /etc/apache2/apache2.conf


# ----------------------------------------------------------
# COPY LARAVEL APPLICATION
# ----------------------------------------------------------
COPY . .


# ----------------------------------------------------------
# COPY BUILT VITE ASSETS
# ----------------------------------------------------------
COPY --from=assets /app/public/build ./public/build


# ----------------------------------------------------------
# INSTALL COMPOSER
# ----------------------------------------------------------
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

RUN composer install \
    --no-dev \
    --no-interaction \
    --prefer-dist \
    --optimize-autoloader \
    --no-scripts


# ----------------------------------------------------------
# SET LARAVEL PERMISSIONS
# ----------------------------------------------------------
RUN set -eux; \
    mkdir -p storage/framework/cache \
             storage/framework/sessions \
             storage/framework/views \
             storage/logs \
             bootstrap/cache; \
    chown -R www-data:www-data storage bootstrap/cache; \
    chmod -R 775 storage bootstrap/cache


# ----------------------------------------------------------
# ENABLE APACHE MODULES
# ----------------------------------------------------------
RUN apache2ctl configtest


# ----------------------------------------------------------
# EXPOSE PORT
# ----------------------------------------------------------
EXPOSE 80

# ----------------------------------------------------------
# START APACHE
# ----------------------------------------------------------
CMD ["apache2-foreground"]
