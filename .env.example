APP_NAME="SNNHS SportsHub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Must match how the app is actually reached from the browser, including any
# subfolder. Uploaded profile photos are served from APP_URL/storage, so a
# wrong value here makes every avatar a broken image.
APP_URL=http://localhost/SportsHub/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sportshub
DB_USERNAME=root
# Leave empty for the default XAMPP install. Never commit a real password here.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypting the session payload is recommended, but switching it on logs
# everyone out once (existing session rows become unreadable). Enable it for
# a fresh production deployment; leave it as-is when upgrading a live one.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Only send the session cookie over HTTPS. Set to true in production once the
# site is served over HTTPS; on a plain http:// local XAMPP install it must
# stay false or sign-in will silently fail to keep the session.
SESSION_SECURE_COOKIE=false
# SameSite policy. "lax" keeps the CSRF protection while allowing normal
# navigation; "strict" is stricter but can break links from other sites.
SESSION_SAME_SITE=lax

# How long a "remember me" login cookie stays valid, in minutes (20160 = 14
# days). The framework default of five years is too long for a shared school
# computer.
AUTH_REMEMBER_COOKIE_LIFETIME=20160

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail - password reset emails (Gmail SMTP)
#
# Password reset links are delivered with the transport below. To use Gmail:
#   MAIL_USERNAME     = the Gmail address that sends SportsHub mail
#   MAIL_PASSWORD     = a 16-character Google App Password, NOT the Gmail
#                       password (https://myaccount.google.com/apppasswords,
#                       requires Google 2-Step Verification)
#   MAIL_FROM_ADDRESS = the same Gmail address (must match the user)
#
# Laravel 12 accepts only MAIL_SCHEME=smtp (STARTTLS on port 587, the normal
# Gmail choice) or MAIL_SCHEME=smtps (implicit TLS on port 465). Scheme "tls"
# is not a valid scheme and will be rejected. MAIL_ENCRYPTION is informational
# here; STARTTLS is negotiated automatically via MAIL_AUTO_TLS (default true).
#
# Never commit a real password here. Afterwards run:  php artisan config:clear
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SNNHS SportsHub"

# ---------------------------------------------------------------------------
# Security - incorrect password warnings
#
# A wrong password on the sign-in screen or on the password change screens
# warns the account holder and the sports coordinators by email. These
# settings control how often those warnings may be sent.
#
#   SECURITY_FAILED_PASSWORD_WARNINGS             = on/off the warnings
#   SECURITY_FAILED_PASSWORD_OWNER_THROTTLE_MINUTES = gap between two
#                                                     warnings for the same
#                                                     account
#   SECURITY_FAILED_PASSWORD_ADMIN_THROTTLE_MINUTES  = gap between two
#                                                     warnings for the same
#                                                     network source
#   SECURITY_FAILED_PASSWORD_ATTEMPT_WINDOW_MINUTES  = window used to count
#                                                     the recent attempts
#
# The defaults live in config/security.php. Afterwards run:
#   php artisan config:clear
# ---------------------------------------------------------------------------
SECURITY_FAILED_PASSWORD_WARNINGS=true
SECURITY_FAILED_PASSWORD_OWNER_THROTTLE_MINUTES=5
SECURITY_FAILED_PASSWORD_ADMIN_THROTTLE_MINUTES=5
SECURITY_FAILED_PASSWORD_ATTEMPT_WINDOW_MINUTES=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Manila
