APP_NAME="SNNHS SportsHub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set this to the public HTTPS URL of the Render web service.
APP_URL=https://your-service.railway.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password
# Optional CA file path for a hosted MySQL provider that requires TLS.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Enable encryption for new production deployments; changing this on a live
# service invalidates existing sessions.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# SameSite policy. "lax" keeps the CSRF protection while allowing normal
# navigation; "strict" is stricter but can break links from other sites.
SESSION_SAME_SITE=lax

# How long a "remember me" login cookie stays valid, in minutes (20160 = 14
# days). The framework default of five years is too long for a shared school
# computer.
AUTH_REMEMBER_COOKIE_LIFETIME=20160

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail - password reset, medical reminders, and Email Reminder module
#
# SportsHub sends mail through Laravel Mail. SMTP credentials are read from
# environment variables only; never hardcode or commit real credentials.
#
# OPTION A: SMTP (local development or hosting plans that allow outbound SMTP)
#   Use any compatible SMTP provider (Gmail SMTP shown below).
#
#   Gmail SMTP:
#     MAIL_MAILER=smtp
#     MAIL_SCHEME=smtp            # smtp=STARTTLS (587), smtps=implicit TLS (465)
#     MAIL_ENCRYPTION=tls         # informational; STARTTLS uses MAIL_AUTO_TLS
#     MAIL_HOST=smtp.gmail.com
#     MAIL_PORT=587
#     MAIL_AUTO_TLS=true
#     MAIL_USERNAME=your-gmail-address@gmail.com
#     MAIL_PASSWORD=16-character-google-app-password   # NOT your Gmail password
#     MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
#     MAIL_FROM_NAME="SNNHS SportsHub"
#
#   Laravel 12 accepts MAIL_SCHEME=smtp or smtps. Scheme "tls" is not valid.
#
# OPTION B: HTTPS email provider (recommended when SMTP connectivity is
# unavailable, including Railway Free/Hobby plans that may block outbound SMTP)
#   Resend is supported by this application (resend/resend-laravel is installed).
#
#     MAIL_MAILER=resend
#     RESEND_KEY=re_your_resend_api_key
#     MAIL_FROM_ADDRESS=noreply@your-verified-domain.example
#     MAIL_FROM_NAME="SNNHS SportsHub"
#
#   Verify your sending domain/address in Resend before production use.
#   If using a failover strategy, configure config/mail.php mailers/failover and
#   set MAIL_MAILER accordingly.
#
# Railway deployment notes:
#   - Do not assume outbound SMTP (ports 25/465/587) is available on Railway
#     Free or Hobby plans. Prefer MAIL_MAILER=resend (HTTPS API) when SMTP is
#     blocked or unreliable.
#   - Email reminders are queued (QUEUE_CONNECTION=database). Run a queue worker
#     as a separate Railway service/process:
#       php artisan queue:work --tries=3 --timeout=90
#     Without a worker, queued reminder emails will remain pending.
#   - The jobs and failed_jobs tables are created by migrations.
#
# After changing mail settings run: php artisan config:clear
# Use the Admin > Email Reminders "Send Test Email" action to verify delivery.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_AUTO_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SNNHS SportsHub"

# HTTPS mail provider (used when MAIL_MAILER=resend)
RESEND_KEY=

# ---------------------------------------------------------------------------
# Security - incorrect password warnings
#
# A wrong password on the sign-in screen or on the password change screens
# warns the account holder and the sports coordinators by email. These
# settings control how often those warnings may be sent.
#
#   SECURITY_FAILED_PASSWORD_WARNINGS             = on/off the warnings
#   SECURITY_FAILED_PASSWORD_OWNER_THROTTLE_MINUTES = gap between two
#                                                     warnings for the same
#                                                     account
#   SECURITY_FAILED_PASSWORD_ADMIN_THROTTLE_MINUTES  = gap between two
#                                                     warnings for the same
#                                                     network source
#   SECURITY_FAILED_PASSWORD_ATTEMPT_WINDOW_MINUTES  = window used to count
#                                                     the recent attempts
#
# The defaults live in config/security.php. Afterwards run:
#   php artisan config:clear
# ---------------------------------------------------------------------------
SECURITY_FAILED_PASSWORD_WARNINGS=true
SECURITY_FAILED_PASSWORD_OWNER_THROTTLE_MINUTES=5
SECURITY_FAILED_PASSWORD_ADMIN_THROTTLE_MINUTES=5
SECURITY_FAILED_PASSWORD_ATTEMPT_WINDOW_MINUTES=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Manila

# Set to false to skip automatic migrations during container startup.
RUN_MIGRATIONS=true
