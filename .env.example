APP_NAME="SNNHS SportsHub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set this to the public HTTPS URL of the Render web service.
APP_URL=https://your-service.railway.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password
# Optional CA file path for a hosted MySQL provider that requires TLS.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Enable encryption for new production deployments; changing this on a live
# service invalidates existing sessions.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# SameSite policy. "lax" keeps the CSRF protection while allowing normal
# navigation; "strict" is stricter but can break links from other sites.
SESSION_SAME_SITE=lax

# How long a "remember me" login cookie stays valid, in minutes (20160 = 14
# days). The framework default of five years is too long for a shared school
# computer.
AUTH_REMEMBER_COOKIE_LIFETIME=20160

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail - password reset and checkup reminder emails (Gmail SMTP)
#
# The administrator can send a checkup reminder from the Medical profile.
# It is delivered to the athlete's registered account email. To use a personal
# Gmail account as the sender:
#   MAIL_USERNAME     = the Gmail address that sends SportsHub mail
#   MAIL_PASSWORD     = a 16-character Google App Password, NOT the Gmail
#                       password (https://myaccount.google.com/apppasswords,
#                       requires Google 2-Step Verification)
#   MAIL_FROM_ADDRESS = the same Gmail address (must match the user)
#
# Laravel 12 accepts only MAIL_SCHEME=smtp (STARTTLS on port 587, the normal
# Gmail choice) or MAIL_SCHEME=smtps (implicit TLS on port 465). Scheme "tls"
# is not a valid scheme and will be rejected. MAIL_ENCRYPTION is informational
# here; STARTTLS is negotiated automatically via MAIL_AUTO_TLS (default true).
#
# Never commit a real password here. Afterwards run:  php artisan config:clear
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_ENCRYPTION=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_AUTO_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SNNHS SportsHub"

# ---------------------------------------------------------------------------
# Security - incorrect password warnings
#
# A wrong password on the sign-in screen or on the password change screens
# warns the account holder and the sports coordinators by email. These
# settings control how often those warnings may be sent.
#
#   SECURITY_FAILED_PASSWORD_WARNINGS             = on/off the warnings
#   SECURITY_FAILED_PASSWORD_OWNER_THROTTLE_MINUTES = gap between two
#                                                     warnings for the same
#                                                     account
#   SECURITY_FAILED_PASSWORD_ADMIN_THROTTLE_MINUTES  = gap between two
#                                                     warnings for the same
#                                                     network source
#   SECURITY_FAILED_PASSWORD_ATTEMPT_WINDOW_MINUTES  = window used to count
#                                                     the recent attempts
#
# The defaults live in config/security.php. Afterwards run:
#   php artisan config:clear
# ---------------------------------------------------------------------------
SECURITY_FAILED_PASSWORD_WARNINGS=true
SECURITY_FAILED_PASSWORD_OWNER_THROTTLE_MINUTES=5
SECURITY_FAILED_PASSWORD_ADMIN_THROTTLE_MINUTES=5
SECURITY_FAILED_PASSWORD_ATTEMPT_WINDOW_MINUTES=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Manila

# Set to false to skip automatic migrations during container startup.
RUN_MIGRATIONS=true
